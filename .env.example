# Copy to .env and fill the values; never commit real keys.
# FAL_KEY: create/manage at https://fal.ai/dashboard/keys (Account -> API Keys).
FAL_KEY=YOUR_FAL_KEY
# GEMINI_API_KEY: create in Google AI Studio at https://aistudio.google.com/app/apikey (or set GOOGLE_API_KEY/Vertex vars instead).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
